---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { services } from '../../data/services';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'Services' }];
const publishedServices = services.filter((service) => service.published);
---

<Layout
 title="Therapy Services in Madison, Wisconsin"
 description="Explore counseling for trauma, anxiety, grief, depression, chronic pain and illness, life transitions, relationships, and personal growth in Madison, Wisconsin."
 schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
 <PageHero
 eyebrow="Individual counseling for adults"
 title="Support for what may be bringing you to therapy."
 intro="Align offers a broader mid-size website structure with dedicated pages for several common concerns while still keeping some topics consolidated into a single services overview."
 crumbs={crumbs}
 />

 <section class="section">
 <div class="container grid grid--2">
 <div>
 <p class="eyebrow">Individual therapy</p>
 <h2>Begin with the concern, question, or change that matters to you.</h2>
 </div>

 <div>
 <p>
 Some people seek counseling because of a specific experience or
 symptom. Others notice patterns in emotions, relationships, stress,
 or daily life that they want to understand more clearly.
 </p>

 <p>
 Align includes several focused service pages for concerns that benefit
 from additional detail, while related concerns remain clearly described
 here so the overall site stays useful without becoming unnecessarily large.
 </p>

 <a class="link-arrow" href="/services/individual-therapy/">
 Learn more about individual therapy
 </a>
 </div>
 </div>
 </section>

 <section class="section section--tint" id="areas-of-support">
 <div class="container">
 <p class="eyebrow">Areas of support</p>
 <h2>Explore what may be bringing you to counseling.</h2>

 <div class="areas">
 {
 publishedServices.map((service) =>
 service.hasDetailPage ? (
 <a
 class="service-card service-link card"
 href={service.href}
 aria-label={`Learn more about ${service.title}`}
 data-track={`service-${service.slug}`}
 >
 <span class="detail-label">Dedicated service page</span>
 <h3>{service.title}</h3>
 <p>{service.description}</p>
 <span class="learn">Learn more →</span>
 </a>
 ) : (
 <article class="service-card card">
 <span class="overview-label">Included on this overview</span>
 <h3>{service.title}</h3>
 <p>{service.description}</p>
 </article>
 )
 )
 }
 </div>
 </div>
 </section>

 <section class="section">
 <div class="container grid grid--2">
 <div>
 <p class="eyebrow">Services and approaches</p>
 <h2>What brings you in and how therapy works are not the same thing.</h2>
 </div>

 <div>
 <p>
 Services describe concerns such as trauma, anxiety, grief, chronic
 pain or illness, relationship difficulties, or life transitions.
 Approaches describe methods Jordan may use during counseling, such as
 IFS, somatic work, EFT, or mindfulness.
 </p>

 <p>
 The Align demo gives two approaches their own detail pages while
 explaining the others on the broader approaches page. That keeps the
 site more focused while still showing a deeper information structure
 than a starter practice website.
 </p>

 <a class="link-arrow" href="/approaches/">
 Explore therapy approaches
 </a>
 </div>
 </div>
 </section>

 <section class="section section--tint">
 <div class="container measure">
 <p class="eyebrow">Finding a place to begin</p>
 <h2>You can start without having the right label.</h2>

 <p>
 Experiences often overlap. If several areas sound familiar—or none of
 them describe your situation exactly—that does not prevent you from
 reaching out.
 </p>

 <a class="link-arrow" href="/contact/">
 Contact and getting started
 </a>
 </div>
 </section>
</Layout>

<style>
 .areas{
 display:grid;
 gap:.75rem;
 margin-top:2rem
 }

 .service-card{
 display:block;
 padding:1.2rem;
 color:var(--body);
 text-decoration:none;
 transition:
 transform .18s ease,
 box-shadow .18s ease,
 border-color .18s ease
 }

 .service-card h3{
 font-family:var(--sans);
 font-size:1rem;
 font-weight:700
 }

 .service-card p{
 font-size:.95rem
 }

 .detail-label,
 .overview-label{
 display:block;
 margin-bottom:.55rem;
 font-size:.68rem;
 font-weight:800;
 letter-spacing:.08em;
 text-transform:uppercase
 }

 .detail-label{color:var(--sage-dark)}
 .overview-label{color:var(--muted)}

 .learn{
 display:inline-block;
 margin-top:.6rem;
 color:var(--sage-dark);
 font-size:.86rem;
 font-weight:750
 }

 @media(hover:hover){
 a.service-card:hover{
 border-color:var(--sage);
 color:var(--body);
 box-shadow:var(--shadow);
 transform:translateY(-2px)
 }
 }

 @media(min-width:36rem){
 .areas{
 grid-template-columns:repeat(2,1fr)
 }
 }

 @media(min-width:64rem){
 .areas{
 grid-template-columns:repeat(3,1fr)
 }
 }
</style>
