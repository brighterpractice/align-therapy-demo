---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { approaches } from '../../data/approaches';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'Approaches' }];
const detailApproachSlugs = new Set([
  'internal-family-systems',
  'somatic-experiencing',
]);
const validApproaches = approaches.filter(
  (approach) => typeof approach.slug === 'string' && approach.slug.length > 0
);
const detailApproaches = validApproaches.filter((approach) =>
  detailApproachSlugs.has(approach.slug)
);
const overviewApproaches = validApproaches.filter(
  (approach) => !detailApproachSlugs.has(approach.slug)
);
---

<Layout
 title="Therapy Approaches in Madison, Wisconsin"
 description="Explore therapy approaches Jordan Ellis may use in individual counseling, including IFS, Somatic Experiencing, EFT, and mindfulness."
 schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
 <PageHero
 eyebrow="How therapy may take shape"
 title="Therapy approaches Jordan may draw from."
 intro="Align’s mid-size site gives two approaches dedicated educational pages and explains additional methods here on the overview."
 crumbs={crumbs}
 />

 <section class="section">
 <div class="container grid grid--2">
 <div>
 <p class="eyebrow">Understanding the difference</p>
 <h2>Services describe what may bring you in. Approaches describe ways of working.</h2>
 </div>

 <div>
 <p>
 A concern such as anxiety, grief, trauma, or relationship difficulty
 does not automatically determine one type of therapy. More than one
 approach may be useful at different points in counseling.
 </p>

 <p>
 This overview explains the larger toolkit, while the dedicated IFS and
 Somatic Experiencing pages provide additional depth for visitors who
 want to understand those methods more fully.
 </p>
 </div>
 </div>
 </section>

 <section class="section section--tint">
 <div class="container">
 <p class="eyebrow">Featured approaches</p>
 <h2>Explore two methods in greater depth.</h2>

 <div class="approach-grid">
 {
 detailApproaches.map((approach) => (
 <a
 class="card service-link"
 href={approach.href}
 data-track={`approach-${approach.slug}`}
 >
 <span class="detail-label">Dedicated approach page</span>
 <h3>{approach.title}</h3>
 <p>{approach.cardDescription}</p>
 <span class="learn">Learn more →</span>
 </a>
 ))
 }
 </div>
 </div>
 </section>

 <section class="section" id="other-methods">
 <div class="container">
 <p class="eyebrow">Additional methods</p>
 <h2>Other approaches can still be part of the work.</h2>
 <p class="measure methods-intro">
 A mid-size site does not need a separate page for every modality. These
 methods remain visible and explained here while keeping the navigation
 focused on the most important detail pages.
 </p>

 <div class="approach-grid secondary-grid">
 {
 overviewApproaches.map((approach) => (
 <article class="card overview-card">
 <span class="overview-label">Included on this overview</span>
 <h3>{approach.title}</h3>
 <p>{approach.cardDescription}</p>
 </article>
 ))
 }
 </div>
 </div>
 </section>

 <section class="section section--tint">
 <div class="container grid grid--2">
 <div>
 <p class="eyebrow">Choosing an approach</p>
 <h2>The method is only one part of therapy.</h2>
 </div>

 <div>
 <p>
 Jordan considers the concern being discussed, how a client responds to
 the work, personal preferences, readiness, and what seems useful as
 counseling develops.
 </p>

 <p>
 You can also say when something does not make sense or does not feel
 like a good fit. Therapy can be adjusted as the work continues.
 </p>

 <div class="overview-links">
 <a class="link-arrow" href="/services/">
 Explore areas of support
 </a>

 <a class="link-arrow" href="/about/jordan-ellis/">
 Learn more about Jordan
 </a>
 </div>
 </div>
 </div>
 </section>
</Layout>

<style>
 .approach-grid{
 display:grid;
 gap:.75rem;
 margin-top:2rem
 }

 .approach-grid a{
 display:block;
 text-decoration:none
 }

 .approach-grid h3{
 margin-bottom:.6rem
 }

 .learn{
 display:inline-block;
 margin-top:.5rem;
 color:var(--sage-dark);
 font-size:.9rem;
 font-weight:750
 }

 .detail-label,
 .overview-label{
 display:block;
 margin-bottom:.55rem;
 font-size:.68rem;
 font-weight:800;
 letter-spacing:.08em;
 text-transform:uppercase
 }

 .detail-label{color:var(--sage-dark)}
 .overview-label{color:var(--muted)}
 .methods-intro{margin-top:1rem}
 .overview-card{padding:1.25rem}

 .overview-links{
 display:grid;
 gap:.5rem;
 margin-top:1.25rem
 }

 @media(min-width:48rem){
 .approach-grid{
 grid-template-columns:repeat(2,1fr)
 }
 }

 @media(min-width:64rem){
 .approach-grid{
 grid-template-columns:repeat(2,1fr)
 }
 }
</style>
